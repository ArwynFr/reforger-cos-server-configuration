@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">COS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column h-100">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Accueil
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/server/cos-1">
                <span class="bi bi-list-server-nav-menu" aria-hidden="true"></span> Serveur 1
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/server/cos-2">
                <span class="bi bi-list-server-nav-menu" aria-hidden="true"></span> Serveur 2
            </NavLink>
        </div>

        <div class="nav-item mt-auto card p-3 m-3">
            <p class="p-0 m-0"> Bonjour @username </p>
            <p class="p-0 m-0 text-secondary small">
                Version @System.Reflection.Assembly.GetEntryAssembly()!.GetName().Version!.ToString(3)
            </p>
        </div>
    </nav>
</div>

@code
{
    private string username = string.Empty;
    private Dictionary<string, object> fieldsetAttributes = [];
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        username = state.User.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty;
        fieldsetAttributes = await AuthorizationService
            .AuthorizeAsync(state.User, SecurityConfiguration.ReadWritePolicyName) switch
        {
            { Succeeded: true } => [],
            _ => new() { { "disabled", "disabled" } }
        };
    }
}