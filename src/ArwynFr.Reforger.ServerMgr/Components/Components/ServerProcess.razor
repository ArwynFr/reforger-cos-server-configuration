@using ArwynFr.Reforger.ServerMgr.Domain

@inject IServiceProvider ServiceProvider

<div class="card d-flex flex-row justify-content-between px-3">
  <div class="d-flex flex-row align-items-center ms-3">
    @if (IsRunning)
    {
      <span class="h2 text-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-check-square-fill"
             viewBox="0 0 16 16">
          <path
          d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm10.03 4.97a.75.75 0 0 1 .011 1.05l-3.992 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.75.75 0 0 1 1.08-.022z" />
        </svg>
      </span>
    }
    else
    {
      <span class="h2 text-danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
             class="bi bi-exclamation-octagon-fill" viewBox="0 0 16 16">
          <path
          d="M11.46.146A.5.5 0 0 0 11.107 0H4.893a.5.5 0 0 0-.353.146L.146 4.54A.5.5 0 0 0 0 4.893v6.214a.5.5 0 0 0 .146.353l4.394 4.394a.5.5 0 0 0 .353.146h6.214a.5.5 0 0 0 .353-.146l4.394-4.394a.5.5 0 0 0 .146-.353V4.893a.5.5 0 0 0-.146-.353zM8 4c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995A.905.905 0 0 1 8 4m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
        </svg>
      </span>
    }

    <div class="border-end border-secondary px-5 py-0 my-4">
      @if (IsRunning)
      {
        <p class="text-success fw-bold m-0">Serveur opérationnel</p>
      }
      else
      {
        <p class="text-danger fw-bold m-0">Serveur arrêté</p>
      }
      @if (IsEnabled)
      {
        <small class="text-secondary m-0">Protection active</small>
      }
      else
      {
        <small class="text-secondary m-0">Protection désactivée</small>
      }
    </div>
    <div class="px-5 py-2 my-2 h2 text-uppercase">
      @ServerName
    </div>
  </div>

  <div class="d-grid gap-2 border-start border-secondary px-5 py-0 my-4" style="grid-template-columns: 1fr 1fr;">
    <button class="btn btn-lg btn-success text-uppercase" @onclick="Start" disabled="@StartDisabled">
      ⏻ On
    </button>
    <button class="btn btn-lg btn-danger text-uppercase" @onclick="Stop" disabled="@StopDisabled">
      ⏻ Off
    </button>
  </div>
</div>

@if (ErrorMessage is not "")
{
  <p class="card p-3 my-3 bg-danger-subtle border-danger-subtle text-danger">
    @ErrorMessage
  </p>
}

@code {
  [Parameter] public required string ServerName { get; set; }
  private ServerManager serverManager => ServiceProvider.GetRequiredKeyedService<ServerManager>(ServerName);
  private bool InProgress { get; set; } = false;

  private bool StartDisabled => InProgress || IsEnabled;
  private bool StopDisabled => InProgress || !IsEnabled;
  private bool IsEnabled => serverManager.Enabled;
  private bool IsRunning => serverManager.Running;
  private string ErrorMessage = string.Empty;

  private async Task Start(MouseEventArgs args)
  {
    try
    {
      InProgress = true;
      await serverManager.Enable(CancellationToken.None);
    }
    catch (Exception ex)
    {
      ErrorMessage = $"Une erreur est survenue : {ex.Message}";
    }
    finally
    {
      InProgress = false;
      StateHasChanged();
    }
  }

  private async Task Stop(MouseEventArgs args)
  {
    InProgress = true;
    await serverManager.Disable(CancellationToken.None);
    InProgress = false;
    StateHasChanged();
  }
}