@using System.Text.Json
@using ArwynFr.Reforger.ServerMgr.Configuration
@using Microsoft.Extensions.Options

@inject IOptions<ReforgerOptions> ReforgerOptions
@inject IHttpClientFactory HttpClientFactory

<div class="card mb-3 bg-primary-subtle">
  <h2 class="h5 card-header">🔧 Configuration </h2>
  @if (ErrorMessage is not "")
  {
    <p class="card p-3 m-3 bg-danger-subtle border-danger-subtle text-danger">
      @ErrorMessage
    </p>
  }
  <textarea class="m-3" @bind="Contents" />
  <div class="card-footer btn-group-vertical">
    <button class="btn btn-primary " @onclick="Fetch">Charger modpack</button>
    <button class="btn btn-success " @onclick="Enregistrer">Enregistrer</button>
  </div>
</div>

@code {
  [Parameter] public required string ServerName { get; set; }

  private string Contents = string.Empty;
  private string ErrorMessage = string.Empty;

  private string Filename => Path.Join([
    ReforgerOptions.Value.BasePath,
    ServerName,
    "config.json"
  ]);

  protected override async Task OnInitializedAsync()
  {
    FileInfo fileInfo = new(Filename);
    if (fileInfo is not { Exists: true })
    {
      ErrorMessage = "Le fichier n'existe pas";
      return;
    }

    using FileStream fileStream = new(fileInfo.FullName, FileMode.Open);
    using StreamReader streamReader = new(fileStream);
    Contents = await streamReader.ReadToEndAsync(CancellationToken.None);
  }

  private async Task Enregistrer(MouseEventArgs args)
  {
    FileInfo fileInfo = new(Filename);
    if (fileInfo.Directory is { Exists: false } parent) { parent.Create(); }
    using FileStream fileStream = new(fileInfo.FullName, FileMode.Create);
    using StreamWriter streamWriter = new(fileStream);
    await streamWriter.WriteAsync(Contents);
  }

  private async Task Fetch(MouseEventArgs args)
  {
    using var client = HttpClientFactory.CreateClient();
    var mods = await client.GetFromJsonAsync<Infrastructure.ArmaReforgerServer.Mod[]>(ReforgerOptions.Value.ModpackUri);
    var config = JsonSerializer.Deserialize<Infrastructure.ArmaReforgerServer.Config>(Contents);
    if (mods is null && config is null) { throw new InvalidOperationException(); }
    config = config! with { Game = config.Game with { Mods = mods! } };
    Contents = JsonSerializer.Serialize(config, new JsonSerializerOptions()
    {
      DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    });
  }
}