@using System.Text.Json
@using ArwynFr.Reforger.ServerMgr.Configuration
@using Microsoft.Extensions.Options

@inject IOptions<ReforgerOptions> ReforgerOptions
@inject IHttpClientFactory HttpClientFactory

<div class="card">
  <div class="d-flex flex-row align-items-center p-1">
    <span class="h5 ms-3"> 📦 Configuration </span>

    @if (ErrorMessage is not "")
    {
      <span class="card p-2 ms-3 bg-danger-subtle border-danger-subtle text-danger">
        @ErrorMessage
      </span>
    }

    @if (SuccessMessage is not "")
    {
      <span class="card p-2 ms-3 bg-success-subtle border-success-subtle text-success">
        @SuccessMessage
      </span>
    }

    <button class="ms-auto btn btn-primary mx-3" @onclick="Fetch">
      @if (InProgress)
      {
        <span class="spinner-grow spinner-grow-sm" aria-hidden="true"></span>
      }
      else
      {
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat"
             viewBox="0 0 16 16">
          <path
          d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9" />
          <path fill-rule="evenodd"
                d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z" />
        </svg>
      }
      <span> Charger modpack </span>
    </button>
    <button class="btn btn-success mx-3" @onclick="Enregistrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cloud-upload"
           viewBox="0 0 16 16">
        <path fill-rule="evenodd"
              d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383" />
        <path fill-rule="evenodd"
              d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708z" />
      </svg>
      <span> Enregistrer </span>
    </button>
    <div class="border-start border-secondary mx-3 ps-3">
      <button class="btn" type="button" data-bs-toggle="collapse" data-bs-target="#configuration" aria-expanded="false"
              aria-controls="configuration">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
             class="bi bi-chevron-compact-down" viewBox="0 0 16 16">
          <path fill-rule="evenodd"
                d="M1.553 6.776a.5.5 0 0 1 .67-.223L8 9.44l5.776-2.888a.5.5 0 1 1 .448.894l-6 3a.5.5 0 0 1-.448 0l-6-3a.5.5 0 0 1-.223-.67" />
        </svg>
      </button>
    </div>
  </div>
  <div class="collapse m-3" id="configuration">
    <textarea class="form-control w-100" @bind="Contents" style="height: 50dvh;" />
  </div>
</div>

@code {
  [Parameter] public required string ServerName { get; set; }

  private string Contents = string.Empty;
  private bool InProgress = false;
  private string ErrorMessage = string.Empty;
  private string SuccessMessage = string.Empty;

  private string Filename => Path.Join([
    ReforgerOptions.Value.BasePath,
    ServerName,
    "config.json"
  ]);

  protected override async Task OnInitializedAsync()
  {
    FileInfo fileInfo = new(Filename);
    if (fileInfo is not { Exists: true })
    {
      ErrorMessage = "Le fichier n'existe pas";
      return;
    }

    using FileStream fileStream = new(fileInfo.FullName, FileMode.Open);
    using StreamReader streamReader = new(fileStream);
    Contents = await streamReader.ReadToEndAsync(CancellationToken.None);
  }

  private async Task Enregistrer(MouseEventArgs args)
  {
    ErrorMessage = string.Empty;
    SuccessMessage = string.Empty;
    FileInfo fileInfo = new(Filename);
    if (fileInfo.Directory is { Exists: false } parent) { parent.Create(); }
    using FileStream fileStream = new(fileInfo.FullName, FileMode.Create);
    using StreamWriter streamWriter = new(fileStream);
    await streamWriter.WriteAsync(Contents);
    SuccessMessage = "Enregistrement réussi";
  }

  private async Task Fetch(MouseEventArgs args)
  {
    try
    {
      InProgress = true;
      ErrorMessage = string.Empty;
      SuccessMessage = string.Empty;
      await Task.Delay(TimeSpan.FromSeconds(2));
      using var client = HttpClientFactory.CreateClient();
      var mods = await client.GetFromJsonAsync<Infrastructure.ArmaReforgerServer.Mod[]>(ReforgerOptions.Value.ModpackUri);
      var config = JsonSerializer.Deserialize<Infrastructure.ArmaReforgerServer.Config>(Contents);
      if (mods is null && config is null) { throw new InvalidOperationException(); }
      config = config! with { Game = config.Game with { Mods = mods! } };
      Contents = JsonSerializer.Serialize(config, new JsonSerializerOptions()
      {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
      });
      SuccessMessage = "Le chargement a réussi";
    }
    catch (Exception)
    {
      ErrorMessage = "Une erreur est survenue";
    }
    finally
    {
      InProgress = false;
    }
  }
}