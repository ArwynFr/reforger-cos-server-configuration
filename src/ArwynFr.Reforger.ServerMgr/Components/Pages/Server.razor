@using ArwynFr.Reforger.ServerMgr.Components.Components
@using Microsoft.AspNetCore.Authorization

@page "/server/{ServerName}"
@rendermode InteractiveServer
@attribute [Authorize]

@inject IServiceProvider ServiceProvider

<PageTitle>Serveur @ServerName</PageTitle>

<div class="container d-flex flex-column h-100 py-3">
    <div class="mb-3 flex-shrink-0">
        <ServerProcess ServerName="@ServerName" />
    </div>
    <div class="flex-grow-1 overflow-hidden row">
        <div class="col-3 h-100">
            <ServerPlayers ServerName="@ServerName" />
        </div>
        <div class="col-9 h-100">
            <ServerLogs ServerName="@ServerName" />
        </div>
    </div>
    <div class="mt-3 flex-shrink-0">
        <ServerConfiguration ServerName="@ServerName" />
        <ServerAdminToolsConfig ServerName="@ServerName" />
    </div>
</div>

@code
{
    [Parameter] public required string ServerName { get; set; }
}