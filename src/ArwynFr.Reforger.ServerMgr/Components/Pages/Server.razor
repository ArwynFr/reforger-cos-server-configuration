@using ArwynFr.Reforger.ServerMgr.Components.Components
@using ArwynFr.Reforger.ServerMgr.Domain
@using Microsoft.AspNetCore.Authorization
@using System.Diagnostics

@page "/server/{ServerName}"
@rendermode InteractiveServer
@attribute [Authorize]

@inject IServiceProvider ServiceProvider

<PageTitle>Serveur @ServerName</PageTitle>

<div class="container">
    <h1 class="mb-5">Serveur : @ServerName</h1>
    <div class="row gx-5">
        <div class="col">
            <ServerProcess ServerName="@ServerName" />
        </div>
        <div class="col">
            <ServerLogs />
            <ServerPlayers ServerName="@ServerName" />
            <ServerAdminToolsConfig ServerName="@ServerName" />
            <ServerConfiguration />
        </div>
    </div>
</div>

@code
{
    [Parameter] public required string ServerName { get; set; }
}